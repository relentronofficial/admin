}

model HelpdeskCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?
  icon        String?
  status      String   @default("active") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  faqs        HelpdeskFaq[]
  tickets     HelpdeskTicket[]

  @@map("helpdesk_categories")
}

model HelpdeskFaq {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question   String   @db.VarChar(500)
  answer     String
  categoryId String?  @map("category_id") @db.Uuid
  status     String   @default("active") @db.VarChar(50)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category   HelpdeskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([status])
  @@map("helpdesk_faqs")
}

model HelpdeskTicket {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId         String?   @map("member_id") @db.Uuid
  name             String    @db.VarChar(255)
  email            String    @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  subject          String    @db.VarChar(255)
  categoryId       String?   @map("category_id") @db.Uuid
  message          String
  attachmentUrl    String?   @map("attachment_url")
  attachmentUrls   Json?     @map("attachment_urls")
  adminNotes       String?   @map("admin_notes")
  adminReply       String?   @map("admin_reply")
  adminRepliedAt   DateTime? @map("admin_replied_at") @db.Timestamptz(6)
  priority         String    @default("medium") @map("priority") @db.VarChar(20)
  preferredContact String?   @map("preferred_contact") @db.VarChar(20)
  displayNumber    Int?      @map("display_number")
  status           String    @default("new") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member           Member?             @relation("MemberHelpdeskTickets", fields: [memberId], references: [id], onDelete: SetNull)
  category         HelpdeskCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  replies          HelpdeskTicketReply[]

  @@index([status])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("helpdesk_tickets")
}

/// Threaded replies on a support ticket. `isFromAdmin` distinguishes
/// admin (Clerk-authed) responses from member follow-ups. Both sides
/// keep the ticket alive; a resolved ticket that receives a member
/// reply is auto-flipped back to 'in_progress' (see controller).
model HelpdeskTicketReply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  body        String
  isFromAdmin Boolean  @default(false) @map("is_from_admin")
  authorName  String?  @map("author_name") @db.VarChar(255)
  memberId    String?  @map("member_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_ticket_replies")
}

model HelpdeskFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String?  @map("member_id") @db.Uuid
  name      String?  @db.VarChar(255)
  email     String?  @db.VarChar(255)
  rating    Int?
  message   String
  status    String   @default("new") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member    Member?  @relation("MemberHelpdeskFeedback", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("helpdesk_feedback")
}

// ── E-books (2026-07-18) ──────────────────────────────────────────
// Ported from co-worker's admin-app ebook module. Same auth swap as
// podcasts — member_id UUID FK, dual auth (admin CRUD + member consume).
model EbookCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  status    String   @default("active") @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  books     Ebook[]

  @@map("ebook_categories")
}

model Ebook {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?
  author       String?  @db.VarChar(255)
  categoryId   String?  @map("category_id") @db.Uuid
  coverImage   String?  @map("cover_image")
  pdfUrl       String?  @map("pdf_url")
  contentUrl   String?  @map("content_url")
  totalPages   Int      @default(0) @map("total_pages")
  readingTime  String?  @map("reading_time") @db.VarChar(50)
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  publishDate  DateTime @default(now()) @map("publish_date") @db.Timestamptz(6)
  status       String   @default("active") @db.VarChar(50)
  // Per-batch access control (matches Workshop.batchIds pattern).
  // null → available to all members; [] → hidden from everyone;
  // [batchId, …] → only members whose batchId is in the array.
  batchIds     Json?    @map("batch_ids")
  // Admin can pin a book to the top of the library. When pinnedAt is
  // non-null the book sorts before all others (most-recently-pinned
  // first). Optional pinnedUntil auto-expires the visual "PINNED"
  // badge — after that timestamp the row keeps its position on the
  // current page but no longer renders as pinned on the client.
  pinnedAt     DateTime? @map("pinned_at")   @db.Timestamptz(6)
  pinnedUntil  DateTime? @map("pinned_until") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category     EbookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookmarks    EbookBookmark[]
  progress     EbookProgress[]
  reviews      EbookReview[]

  @@index([categoryId])
  @@index([status])
  @@map("ebooks")
}

model EbookBanner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String   @db.VarChar(255)
  subtitle        String?
  backgroundImage String?  @map("background_image")
  buttonText      String?  @map("button_text") @db.VarChar(100)
  buttonLink      String?  @map("button_link")
  status          String   @default("active") @db.VarChar(50)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ebook_banners")
}

model EbookBookmark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  bookId     String   @map("book_id") @db.Uuid
  pageNumber Int?     @map("page_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member     Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  book       Ebook  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([memberId, bookId])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("ebook_bookmarks")
}

model EbookProgress {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId            String   @map("member_id") @db.Uuid
  bookId              String   @map("book_id") @db.Uuid
  currentPage         Int      @default(0) @map("current_page")
  totalPages          Int      @default(0) @map("total_pages")
  progressPercentage  Decimal  @default(0) @map("progress_percentage") @db.Decimal(5, 2)
  completed           Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member              Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  book                Ebook  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([memberId, bookId])
  @@index([memberId, updatedAt(sort: Desc)])
  @@map("ebook_progress")
}

// Per-member reading streak tracker. One row per member, incremented
// on any /api/ebooks/progress submission. Streak counts consecutive
// calendar days with at least one progress update; skipping a day
// resets to 1. Longest streak preserves the historical high.
model EbookReadingStreak {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String    @unique @map("member_id") @db.Uuid
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@map("ebook_reading_streaks")
}

// Member-submitted ratings/reviews on ebooks. One row per (member, book);
// re-submitting overwrites the previous rating/text and drops back to
// `pending` for admin moderation. Only rows with status='approved' are
// surfaced on the public detail page.
model EbookReview {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  bookId     String   @map("book_id")   @db.Uuid
  rating     Int                                          // 1..5, enforced in Zod
  reviewText String?  @map("review_text")
  status     String   @default("pending") @db.VarChar(20) // pending | approved | rejected
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  book       Ebook    @relation(fields: [bookId],   references: [id], onDelete: Cascade)

  @@unique([memberId, bookId])
  @@index([bookId, status])
  @@map("ebook_reviews")
}

// Named PodcastEpisodeProgress (mapped to podcast_episode_progress table)
// because a legacy PodcastProgress model + podcast_progress table already
// exists in this schema (scaffolded years ago, never wired). Renaming
// avoids a destructive DROP of the empty legacy table.
model PodcastEpisodeProgress {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId               String   @map("member_id") @db.Uuid
  episodeId              String   @map("episode_id") @db.Uuid
  currentPositionSeconds Int      @default(0) @map("current_position_seconds")
  totalDurationSeconds   Int      @default(0) @map("total_duration_seconds")
  completed              Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member                 Member         @relation("MemberPodcastEpisodeProgress", fields: [memberId], references: [id], onDelete: Cascade)
  episode                PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([memberId, episodeId])
  @@index([memberId, updatedAt(sort: Desc)])
  @@map("podcast_episode_progress")
}
