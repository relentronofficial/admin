// ── Master data (2026-07-16) ─────────────────────────────────────────
// Shared vocabulary for member profile fields — city, state, business
// type. Enforced case-insensitive unique via a lower(name) index
// declared in backend/src/plugins/prisma.ts startup SQL. Prisma
// unfortunately can't express the functional-index UNIQUE constraint
// directly, so the model here only declares the raw `name` column;
// the actual dedup guarantee lives on the DB side.
//
// Members store city/state/businessType as plain strings on the row.
// The master tables are for autocomplete + admin visibility, not FK
// integrity — see plugins/prisma.ts for the rationale.

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cities")
}

model State {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("states")
}

model BusinessType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("business_types")
}

// ── AI Content Buddy (2026-07-18) ─────────────────────────────────
// Claude-backed chat assistant. Ported from the co-worker's admin-app,
// re-modelled onto our JWT-cookie auth so member_id FKs into members.
// See modules/ai/ and specs/001-ai-content-assistant/ for the design
// rationale (mirror + shorten of the co-worker's spec-kit doc).
model AIConversation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String       @map("member_id") @db.Uuid
  title     String       @default("New Conversation")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  saved     SavedAIContent[]

  @@index([memberId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  sender         String
  message        String
  inputType      String         @map("input_type")
  imageUrl       String?        @map("image_url")
  contentType    String?        @map("content_type")
  language       String?
  tone           String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model SavedAIContent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  title          String
  content        String
  category       String          @default("other")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt(sort: Desc)])
  @@map("saved_ai_content")
}

model AIUsageCounter {
  memberId    String   @map("member_id") @db.Uuid
