# ── Autonomous dev system — logs only (config/queue are tracked) ─────────────
.claude/devops/audit.jsonl
.claude/devops/health.jsonl
.claude/devops/notifications.jsonl
.claude/devops/session.jsonl
.claude/worktrees/

# ── Backup & third-party snapshots ─────────────────────────────────────────────
tbt-admin-safe/

# ── Video recordings (never source; too heavy to version) ──────────────────────
*.mp4

# ── Vercel local state ─────────────────────────────────────────────────────────
.vercel

# ── Test results (environment-specific, not source) ───────────────────────────
tests/results/*.json

# ── Repo-root debugging artifacts ──────────────────────────────────────────────
# These accumulate at the repo root from manual QA + screenshot-driven debugging
# sessions. They're the user's local trail — don't stage them and don't delete
# them either (per project convention). If you need to add a permanent asset,
# put it under a proper subfolder (e.g. docs/, assets/) instead of the root.

# One-off screenshots (Playwright + adb + Percy captures)
/*.png
/*.jpeg
/*.jpg

# One-off audit / test scripts
/*-audit.mjs
/*-test-*.mjs
/*-test.mjs
/admin-full-audit.mjs
/cue-quiz-browser-test.mjs
/generate-task-audit.mjs
/test-*.mjs
/user-app-audit.mjs

# Manual test logs
/backend-*.log
/audit-log.txt
/build-log.txt
/cd-test-log.txt
/flow-*-log.txt
/user-audit-log.txt

# Percy + Playwright config that only runs from the workstation
/.playwright-mcp/
/.playwright/
/test-results/
/playwright.config.ts

# Editor / IDE noise
/.idea/

# Vercel local overrides
/.vercelignore

# node_modules at the repo root (from ad-hoc npm installs — real deps live in
# tbt-admin/, tbt-user-web/, tbt_app/ per-package node_modules).
/node_modules/

# Clerk session / token dumps saved during Playwright debugging
/clerk-*.json

# Ad-hoc PDF/MD artifacts from manual QA
/IMAGE_ASSET_SPEC.pdf
/IMAGE_ASSET_SPEC.md
/TBT_Flutter_Migration_Plan.md

# Ad-hoc scripts, notes, and DB seed shims at the repo root
/task.txt
/task-workflow-audit.pdf
/run-percy.ps1
/percy/

# Editor tmp files that shell commands sometimes leave behind
**/*.tmp.*.*
prisma.*

# tbt_app screenshot debugging (from adb screencap / playwright)
tbt_app/shot*.png
tbt_app/tbt-test-*.png
tbt_app/tbt-workshops-*.png
tbt_app/ui.xml
tbt_app/compare-*.png
tbt_app/verify-*.png
tbt_app/*-log.txt

# tbt-admin backend/admin one-off scripts + tsc temp files
tbt-admin/backend/check_db.ts
tbt-admin/backend/db-check.mjs
tbt-admin/backend/seed-*.mjs
tbt-admin/backend/src/**/*.tmp.*.*
tbt-admin/admin-panel/run-percy.ps1
tbt-admin/.vercelignore
tbt-admin/admin-panel/.vercelignore
tbt-admin/SPECKIT.md

# Custom brand asset added by user — not part of the app bundle
tbt-user-web/TBT*.png
</content>
