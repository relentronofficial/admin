<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom layer: solid launch bg. If the bitmap above doesn't cover
         the entire window (e.g. odd aspect ratio, briefly during decode),
         this paints the same colour as the Flutter splash so there's no
         flash. -->
    <item android:drawable="@color/tbt_launch_bg"/>
    <item>
        <bitmap android:gravity="fill" android:src="@drawable/background"/>
    </item>
</layer-list>
